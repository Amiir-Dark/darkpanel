# ==================================================
# DarkPanel Pay-As-You-Go Telegram Bot Configuration
# ==================================================

# توکن ربات تلگرام دریافتی از @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# آدرس پنل DarkPanel (بدون اسلش انتهایی)
# مثال برای اجرای لوکال: http://127.0.0.1:8000
# یا آدرس عمومی: https://tun.zonixserver.dpdns.org:2096
PANEL_URL=http://127.0.0.1:8000

# نام کاربری و رمز عبور ادمین DarkPanel (جهت اتصال به API)
PANEL_USERNAME=Amir
PANEL_PASSWORD=your_panel_password

# در صورت استفاده از API Key ادمین، می‌توانید آن را اینجا قرار دهید (اختیاری):
# PANEL_API_KEY=your_admin_api_key

# آیدی‌های عددی تلگرام ادمین‌های ربات (با کاما جدا کنید)
ADMIN_IDS=12345678,87654321

# قیمت پیش‌فرض هر ۱ گیگابایت ترافیک به تومان (قابل تغییر از داخل خود ربات)
PRICE_PER_GB=5000

# حداقل موجودی کیف پول جهت فعال‌سازی اولیه سرویس (تومان)
MIN_BALANCE_TO_START=5000

# بازه زمانی بررسی و کسر مصرف از کیف پول (به ثانیه)
SYNC_INTERVAL_SECONDS=120

# مسیر فایل دیتابیس SQLite ربات
DATABASE_PATH=bot.db

# آیدی پشتیبانی و کانال اطلاع‌رسانی
SUPPORT_USERNAME=@AdminSupport
CHANNEL_USERNAME=@MyChannel
